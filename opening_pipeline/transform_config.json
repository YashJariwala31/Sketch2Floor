{
  "paths": {
    "template": "opening_pipeline/output.json",
    "geometry": "predictions/{IMAGE}_geometry.json",
    "output": "placed_doors.json",
    "walls": "intermediate/wall_polygons.json"
  },

  "template": {
    "height": 30.0,
    "origin": "hinge"
  },

  "hinge_strategy": {
    "mode": "arc_based"
  },

  "transform": {
    "order": ["scale", "rotate", "translate"],
    "scale_source": "height"
  },

  "apply_on": ["leaf", "arc"]
}
