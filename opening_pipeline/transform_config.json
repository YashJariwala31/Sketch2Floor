{
  "paths": {
    "template": "opening_pipeline/output.json",
    "geometry": "predictions/{IMAGE}_geometry.json",
    "output": "placed_doors.json",
    "walls": "intermediate/wall_polygons.json"
  },

  "template": {
    "height": 30.0,
    "origin": "hinge"
  },

  "hinge_strategy": {
    "mode": "bbox_based",
    "bbox_rules": {
      "horizontal": {"x": "x", "y": "center_y", "rotation": 0},
      "vertical": {"x": "center_x", "y": "y", "rotation": 90}
    }
  },

  "wall_snap": {
    "max_distance": 15.0
  },

  "transform": {
    "order": ["scale", "rotate", "translate"],
    "scale_source": "height"
  },

  "apply_on": ["leaf", "arc"]
}
